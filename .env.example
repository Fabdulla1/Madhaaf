# Create a Supabase project (or run the Supabase local stack), then copy this
# file to .env.local and set the project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for account management, verified uploads and media delivery.
SUPABASE_SECRET_KEY=
# Canonical public origin for password recovery links. Keep HTTPS in production.
SITE_URL=https://madhaaf.vercel.app
